# Copy to .env (or set these in your hosting dashboard). All are optional:
# the site runs with sensible defaults if none are set.

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
SITE_URL=https://www.yourdomain.com

# PostgreSQL in production. Leave unset to use the local db.sqlite3
DATABASE_URL=postgres://user:password@host:5432/dbname

# Gmail App Password used for enquiry / booking e-mails
EMAIL_HOST_USER=annanagarcsc2024@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
